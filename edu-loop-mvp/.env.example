# 复制为 .env 后填入真实凭据：
#   macOS / Linux      cp .env.example .env
#   Windows PowerShell Copy-Item .env.example .env
#
# 未配置任何 key 时，服务会自动降级到内置的 mock 适配器，
# 仍然可以完整跑通五步教学闭环（输出为确定性示例内容）。
# 请不要把真实 key 写进本文件——本文件会进入版本库，只有 .env 被 .gitignore 忽略。

# DeepSeek
DEEPSEEK_API_KEY=

# 火山方舟（豆包）
DOUBAO_LLM_API_KEY=

# 其他 OpenAI 兼容端点：在 llm.config.json 里新增 provider 并引用这里的环境变量名即可
# MY_GATEWAY_API_KEY=

# 注意：端点地址、模型 id、超时等都在 llm.config.json 的 provider profile 里配置，
# 不通过这里的环境变量读取（本文件只负责凭据）。