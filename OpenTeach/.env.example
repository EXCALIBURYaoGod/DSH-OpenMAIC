# =============================================================================
# OpenTeach 环境变量模板（只放凭据；端点地址 / 模型 id 不在这里，见 llm.config.json）
# -----------------------------------------------------------------------------
# 用法：
#   macOS / Linux        cp .env.example .env.local
#   Windows PowerShell   Copy-Item .env.example .env.local
# 然后填入真实值。本文件务必保持空白，不要写入任何真实凭据。
#
# 如何被加载：bundle patch（cordis.patch.yml）以 `envPath: ./.env.local` 指定，
# 相对路径按**本包根目录**解析（与启动 dsh 的工作目录无关）；也可用
# OPENTEACH_ENV_PATH 指向绝对路径（未显式配置 envPath 时生效）。
# 所有凭据留空时：OpenTeach llm 插件自动降级为内置 mock 适配器（界面显示
# 「本地降级」），无需任何 Key 也能跑通；但 OpenMAIC 核心生成链路
# （/api/generate/*）需要真实 Key，否则会报 MISSING_API_KEY。
# =============================================================================

# ---- OpenTeach LLM 插件凭据（变量名与 llm.config.json 的 apiKeyEnv 一一对应）----

# provider: deepseek → https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# provider: doubao（火山方舟）。端点与模型 id 按旧约定写在 llm.config.json 的
# doubao profile 里，不在此处配置：
#   DOUBAO_LLM_URL   →  https://ark.cn-beijing.volces.com/api/v3
#   DOUBAO_LLM_MODEL →  doubao-seed-2-1-pro-260628
DOUBAO_LLM_API_KEY=

# ---- OpenMAIC 核心（openmaic-core）的 provider 约定 ----
# 核心生成链路读 {PREFIX}_API_KEY / {PREFIX}_BASE_URL / {PREFIX}_MODELS，
# 豆包的 prefix 为 DOUBAO。要与上面共用同一把 Key，把值重复填到这里即可。
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODELS=

# ---- 持久化（openmaic-core 的 stages/persistence 等路由必需）----
DATABASE_URL=