{
  "compilerOptions": {
    "target": "ES2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "next/server": ["./src/shim/server.ts"],
      "next/headers": ["./src/shim/headers.ts"]
    }
  },
  "include": ["src", "build.mjs"],
  "exclude": ["node_modules", "lib"]
}